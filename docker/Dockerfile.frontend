# syntax=docker/dockerfile:1
FROM node:22-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
# docs/ is the canonical landing page; the prebuild hook copies it into
# public/landing so the built bundle serves it from the app's own origin.
# Absolute path here matches what scripts/sync-landing.mjs resolves to (/docs).
COPY docs/ /docs/
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
